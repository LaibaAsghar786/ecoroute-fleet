# GEMINI_API_KEY: Optional Gemini AI API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the application.
APP_URL="MY_APP_URL"

# AUTH_SECRET: HMAC secret used to sign manager/driver authentication tokens.
AUTH_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET"

# ECOROUTE_ANCHOR_SECRET: HMAC secret used to sign cryptographic hash-chain anchors.
ECOROUTE_ANCHOR_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_SECRET"

# ALLOW_DEMO_TOOLS: Set to "true" only if demo tamper/seed reset endpoints should be enabled in production.
ALLOW_DEMO_TOOLS="false"

# Optional persistent Redis/KV store for Vercel serverless deployments (Upstash Redis / Vercel KV):
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
