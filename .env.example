# APP_URL: Public base URL of the hosted EcoRoute Fleet web application
APP_URL="MY_APP_URL"

# Authentication & Cryptographic Chain Signing Secrets
AUTH_SECRET="replace-with-strong-random-auth-secret"
ECOROUTE_ANCHOR_SECRET="replace-with-strong-random-anchor-secret"

# Comma-separated CORS origin allowlist (in addition to localhost / Vercel / Cloud Run origins)
CORS_ALLOWED_ORIGINS=""

# Demo tamper/seed endpoints are disabled in production unless explicitly set to "true"
ALLOW_DEMO_TOOLS="false"

# Optional Upstash / Vercel KV REST credentials for persistent serverless storage
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
